service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only access to products collection (for browsing only).
    // This allows get and list operations for /products/* documents.
    // Writes are explicitly denied here — use authenticated rules for writes.
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Deny access to all other documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
